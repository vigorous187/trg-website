---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatted = new Date(post.data.publishDate).toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Document <title> only. PageIntro keeps post.data.title as the H1.
const metaTitleOverrides: Record<string, string> = {
  "expand-your-reach-restaurant-marketing-strategies-across-toronto-brampton-mississauga":
    "Restaurant Marketing Across the GTA | TRG",
  "google-ads-local-campaign-restaurants":
    "Local Google Ads for Restaurants | Toronto Restaurant Growth",
  "grand-opening-success-specialized-marketing-torontos-halal-restaurants":
    "Halal Restaurant Grand Opening | Toronto Restaurant Growth",
  "halal-restaurant-marketing-gta":
    "Halal Restaurant Marketing GTA | Toronto Restaurant Growth",
  "instagram-reels-restaurant-promo-2026":
    "Instagram Reels for Restaurants | Toronto Restaurant Growth",
  "mastering-online-presence-restaurant-website-design-google-reviews-toronto":
    "Website Design & Google Reviews | Toronto Restaurant Growth",
  "tiktok-google-reviews-engagement-toronto-restaurants-social-media":
    "TikTok & Google Reviews Toronto | Toronto Restaurant Growth",
  "toronto-restaurant-marketing-local-seo-google-maps":
    "Local SEO & Google Maps Toronto | Toronto Restaurant Growth",
  "toronto-restaurants-rank-google-maps":
    "Google Maps SEO for Restaurants | Toronto Restaurant Growth",
  "why-your-restaurant-not-showing-on-google":
    "Restaurant Not Showing on Google | Toronto Restaurant Growth",
};

const slug = post.id.replace(/\.mdx?$/, "");
const withBrand = `${post.data.title} | Toronto Restaurant Growth`;
const withShortBrand = `${post.data.title} | TRG`;
const documentTitle =
  metaTitleOverrides[slug] ??
  (withBrand.length <= 60
    ? withBrand
    : withShortBrand.length <= 60
      ? withShortBrand
      : withBrand);
---

<BaseLayout
  title={documentTitle}
  description={post.data.description}
>
  <main>
    <PageIntro title={post.data.title} description={post.data.description} ctaLabel="Book a Free Google Audit" ctaHref="/contact/" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <article
        class="prose prose-lg mx-auto max-w-3xl px-4 sm:px-6 lg:px-8
          prose-headings:font-heading prose-headings:text-ink
          prose-p:text-ink-muted prose-p:leading-relaxed
          prose-a:text-cta prose-a:font-medium hover:prose-a:underline
          prose-strong:text-ink
          prose-li:text-ink-muted prose-li:marker:text-accent"
      >
        <p class="text-sm text-ink-muted">{formatted} · {post.data.category}</p>
        <Content />
      </article>
    </section>
  </main>
</BaseLayout>
